# Copy to /etc/aave-watch/fetch.env (mode 600, owner root) and fill in.
# One HTTP endpoint per chain id; a chain with no line is skipped. Catch-up needs historical logs.
RPC_HTTP_1=
RPC_HTTP_8453=
RPC_HTTP_43114=
RPC_HTTP_5042=
# Optional. Defaults shown.
#CLICKHOUSE_URL=http://127.0.0.1:8123
#FETCH_RANGE=2000          # blocks per eth_getLogs to start from; adapts, capped at 10000
#FETCH_PARALLEL=4          # ranges in flight per chain
#FETCH_MAX_ADDRESSES=0     # addresses per eth_getLogs; 0 = all in one request. Public nodes need 10.
#FETCH_NO_SEED=0           # 1 = ignore registry/spokes.toml and discover every Spoke from the Hubs (test only: more requests)
