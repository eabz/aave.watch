{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aave-watch",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-17",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// Custom domains only; without this every deploy turns the workers.dev URL back on.
	"workers_dev": false,
	"routes": [
		{ "pattern": "aave.watch", "custom_domain": true },
		{ "pattern": "www.aave.watch", "custom_domain": true }
	],
	// The API on the box, through the Cloudflare Tunnel "aave-watch-box" (Workers VPC). No public hostname.
	"vpc_services": [
		{ "binding": "API", "service_id": "01a1ef52-9070-7be1-880c-da6f8754fb56", "remote": true }
	],
	// The web build is served from this Worker; /v1/* goes to the code in src/.
	"assets": {
		"directory": "../web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/v1/*"]
	}
}
