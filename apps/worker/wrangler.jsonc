{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aave-watch",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-17",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// Custom domains only; without this every deploy turns the workers.dev URL back on.
	"workers_dev": false,
	"routes": [
		{ "pattern": "aave.watch", "custom_domain": true },
		{ "pattern": "www.aave.watch", "custom_domain": true }
	],
	// The API on the box, through the Cloudflare Tunnel "aave-watch-box" (Workers VPC). No public hostname.
	"vpc_services": [
		{ "binding": "API", "service_id": "01a1ef52-9070-7be1-880c-da6f8754fb56", "remote": true }
	],
	// The web build is served from this Worker. The code in src/ runs first for everything except the
	// static files below: /v1/* (API), /og/* (share images) and pages (link-preview tags in the head).
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/*", "!/assets/*", "!/icons/*", "!/fonts/*", "!/favicon.svg", "!/robots.txt"]
	},
	// Share images: the fonts as bytes. The renderer's .wasm is bundled by wrangler's default rule.
	"rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }]
}
